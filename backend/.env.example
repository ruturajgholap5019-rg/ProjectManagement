# ============================================================================
# Backend Environment Variables (Production & Render)
# ============================================================================

PORT=5000
NODE_ENV=production

# Supabase PostgreSQL Connection String (Transaction Pooler / Session mode)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Authentication Security (Generate strong 32+ char random keys)
JWT_ACCESS_SECRET="generate-a-strong-32-character-secret-key-12345"
JWT_REFRESH_SECRET="generate-a-strong-32-character-secret-key-67890"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# CORS Configuration (Set to your Vercel frontend URL)
CORS_ORIGIN="https://your-frontend-project.vercel.app"

# Upload Configuration
MAX_FILE_SIZE_BYTES=52428800
UPLOAD_DIR="./uploads"

# Optional Email Service (Resend)
RESEND_API_KEY=""
EMAIL_FROM="Project Tracker <onboarding@resend.dev>"
